{
  "name": "@bismawy/pi-auto-compat",
  "version": "1.4.0",
  "description": "Auto-fix missing compat flags in Pi's models.json — mirrors pi-cache-optimizer detection so compat warnings never appear. Registry-driven, credential-safe, refreshes in-process.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "compat",
    "models-json",
    "cache-optimizer",
    "proxy"
  ],
  "author": "bismawy",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "imports": {
    "#extension": "./index.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bismawy/pi-auto-compat.git"
  }
}